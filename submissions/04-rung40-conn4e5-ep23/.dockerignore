# Keep the build context small. do_save.sh writes multi-gigabyte *.tar.gz
# archives into this folder, and without this file Docker would send them
# (and the sample batch) to the daemon on every build.
*.tar.gz
test/
__pycache__/

# _artifacts/ holds the 17 GB broken image tar AND a hardlinked twin of
# resources/model. The legacy builder streams the WHOLE context to the daemon
# before step 1, so without this the build ships 53.28 GB of context in order to
# copy 34 GB of weights -- and that overhead is what filled the root partition
# twice on 2026-08-25.
_artifacts/
*.tar
